    project_id=$(oci data\-science project create \-\-compartment\-id $compartment_id \-\-query data.id \-\-raw\-output)

    model_deployment_id=$(oci data\-science model\-deployment create \-\-compartment\-id $compartment_id \-\-model\-deployment\-configuration\-details file://model\-deployment\-configuration\-details.json \-\-project\-id $project_id \-\-query data.id \-\-raw\-output)

    oci data\-science model\-deployment update \-\-model\-deployment\-id $model_deployment_id
.ft P
.fi
